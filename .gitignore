# The source books are about 100 MB.
# books/ contributes the Markdown conversions.
books/**/*.pdf
books/**/*.djvu
books/**/*.epub

# The PDF of each chapter is built by `make pdf` and rebuilt by the publishing
# workflow. They are downloaded from the site; they do not live in the repository.
docs/**/*.pdf

# The PlDoc sites of the examples are built by `make pldoc` from ejemplos/,
# and rebuilt by the publishing workflow like the PDFs.
docs/*/pldoc/

# The narrated video of each slide deck is built by `make video` from the deck.
diapositivas/*.mp4

# Environment and build artefacts
.venv/
site/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Anchored to the root: this is the working scratch directory of this tree. An
# example that happens to be called tmp/ inside a chapter is still versioned.
/tmp/

# What the commands of chapter 31 build from the examples: construir.pl writes
# into salida/ (with the .bat launchers), qcompile/1 writes .qlf files, and a
# pack is packed into a .tgz.
ejemplos/**/salida/
ejemplos/**/*.state
ejemplos/**/*.qlf
ejemplos/**/*.tgz

# PlDoc writes to html/ by default when run on a directory without an output folder;
# the course's pages come from `make pldoc` into docs/<chapter>/pldoc/ instead.
/html/

# The work directory of tools/assistant/keywords.py: inputs and answers of the agents that write the
# assistant's search keywords, and blind question sets.
/.assistant-work/
