// Settings that travel with the repository, so the book does not depend on how
// each contributor happens to have VS Code set up.
//
// The file is JSONC: VS Code allows comments here, unlike plain JSON.
{
	// Markdown is never reformatted on save. The text of this book is wrapped by
	// hand at about 80 columns and its tables are written compact (`|---|---|`),
	// and a formatter undoes both.
	//
	// There is also a case where reformatting corrupted the source. A table cell
	// such as `[Primero\|Resto]` holds a pipe inside an inline code span, and
	// while the book wrote it unescaped a formatter read it as a column
	// boundary, counted one column too many, and padded the cell *inside* the
	// backticks — leaving `[Primero        | Resto]` in the rendered page. It
	// happened to the summary table of chapter 1 more than once.
	//
	// The book now escapes those pipes as GFM requires (`\|`), which the VS Code
	// previews, GitHub and the PDF read natively; the site and the decks remove
	// the backslash themselves (`tools/tabla_pipes.py`, `tools/tabla_pipes.lua`).
	// Formatting stays off all the same: the hand wrapping and the compact tables.
	"[markdown]": {
		"editor.formatOnSave": false
	},

	// Belt and braces: this is the setting of "Markdown All in One", the most
	// common source of the reformatting described above.
	"markdown.extension.tableFormatter.enabled": false,

	// Prolog examples are indented with four spaces and no tabs, which is what
	// `make check` compares against the text.
	"[prolog]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 4
	},

	// Python under tools/ is formatted by ruff, through pre-commit. Leaving the
	// editor out of it keeps the two from disagreeing.
	"[python]": {
		"editor.formatOnSave": false
	},

	// The repository stores LF; see .gitattributes. Writing CRLF from the editor
	// turns every touched file into a whole-file diff.
	"files.eol": "\n",
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"cSpell.words": [
		"algun",
		"descomponerlas",
		"estan",
		"felix",
		"fisica",
		"instanciada",
		"instanciadas",
		"logica",
		"maplist",
		"nondet",
		"quimica",
		"recursión",
		"recursiones",
		"semidet",
		"sofia",
		"sublista",
		"vacia"
	]
}
